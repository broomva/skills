{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // scripts/ holds Bun programs (Veo generation, the video renderer, the hub
  // capture). They lived outside the Next app before the move and are still not
  // part of its module graph; they run under Bun, whose globals this app does
  // not depend on types for. Including them here would fail `next build` on
  // `Bun` and `import.meta.dir` without typechecking anything the site renders.
  "exclude": ["node_modules", "out", "scripts"]
}
