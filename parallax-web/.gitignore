# The old repository's .gitignore did not come across in the move, and the
# monorepo root only ignores node_modules/, .cache/, dist/, *.skill, .control/
# and __pycache__. Everything below is generated by a build or a render, and CI
# writes out/ on every pull request, so without this a `git add -A` sweeps a
# static export -- and raw Veo footage -- into the repository.
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
