node_modules/
.cache/
dist/
*.skill

# bstack control-gate audit trail — written relative to cwd by the PreToolUse
# hook when an agent runs commands inside this repo; never part of the repo.
.control/

# Python bytecode (never vendor compiled artifacts)
__pycache__/
*.pyc
.pytest_cache/

# parallax-web build outputs — Next.js static export (`output: "export"`), plus
# the cinema captures that are rendered rather than authored.
parallax-web/.next/
parallax-web/out/
parallax-web/next-env.d.ts
parallax-web/tsconfig.tsbuildinfo
parallax-web/cinema/assets/

# Parallax runtime state. The CLI writes its sqlite event log and its `.parallax/`
# thread state into whatever directory it is run from (STATE_DIR in
# skills/simulation/parallax/runtime/src/tools/state.ts), so these are not scoped
# to a path — an agent running `parallax status` anywhere in the repo drops them
# beside itself. No `.db` is tracked here today.
*.db
*.db-*
.parallax/
