ason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":10,"cache_creation_input_tokens":6946,"cache_read_input_tokens":17536,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6946},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"REDACTED","uuid":"7b7f9152-e841-4667-a60d-85c009929b25","timestamp":"2026-07-29T04:51:20.496Z","request_id":"req_011CdVkKhNfr7nimbixKqZWM"}
