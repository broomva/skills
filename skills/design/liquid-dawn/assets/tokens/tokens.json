{
  "$schema": "liquid-dawn/tokens@1",
  "name": "Liquid Dawn",
  "version": "0.1.0",
  "modes": [
    "dawn",
    "dusk"
  ],
  "color": {
    "paper": {
      "dawn": "oklch(0.972 0.006 95)",
      "dusk": "oklch(0.2 0.02 228)",
      "role": "Page ground. Dawn is warm paper, never pure white; Dusk is a sea-slate evening, never neutral black, never purple."
    },
    "surface": {
      "dawn": "oklch(0.992 0.003 95)",
      "dusk": "oklch(0.245 0.022 228)",
      "role": "Opaque panels; the reduced-transparency and high-contrast fallback for glass."
    },
    "sunk": {
      "dawn": "oklch(0.945 0.008 95)",
      "dusk": "oklch(0.175 0.018 228)",
      "role": "Recessed wells: code, inputs at rest, field frames."
    },
    "ink": {
      "dawn": "oklch(0.25 0.02 235)",
      "dusk": "oklch(0.955 0.008 95)",
      "role": "Primary text and headlines. Dawn ink is slate-blue (the Midnight lineage); Dusk ink is paper."
    },
    "ink2": {
      "dawn": "oklch(0.43 0.018 235)",
      "dusk": "oklch(0.81 0.014 220)",
      "role": "Body copy, ledes, inactive labels."
    },
    "ink3": {
      "dawn": "oklch(0.52 0.016 235)",
      "dusk": "oklch(0.68 0.018 220)",
      "role": "Metadata and tags. Passes 4.5:1 on paper and surface in both modes."
    },
    "line": {
      "dawn": "oklch(0.3 0.02 235 / 0.09)",
      "dusk": "oklch(0.9 0.02 220 / 0.1)",
      "role": "Hairlines and the field grid."
    },
    "line2": {
      "dawn": "oklch(0.3 0.02 235 / 0.18)",
      "dusk": "oklch(0.9 0.02 220 / 0.2)",
      "role": "Visible edges."
    },
    "tide": {
      "dawn": "oklch(0.52 0.1 215)",
      "dusk": "oklch(0.8 0.1 205)",
      "role": "THE accent: the payoff phrase, kickers, focus ring, the active item. One accent per surface."
    },
    "glass": {
      "dawn": "oklch(1 0 0 / 0.5)",
      "dusk": "oklch(0.3 0.02 225 / 0.42)",
      "role": "Dew-glass base tint."
    },
    "glass-heavy": {
      "dawn": "oklch(0.99 0.003 95 / 0.9)",
      "dusk": "oklch(0.25 0.022 228 / 0.92)",
      "role": "Reduced-transparency glass."
    },
    "shadow": {
      "dawn": "oklch(0.35 0.05 230)",
      "dusk": "oklch(0.08 0.02 228)",
      "role": "Shadow ink, always hued to the ground, never black. Used with alpha."
    }
  },
  "nature": {
    "sky": {
      "dawn": "oklch(0.8 0.07 232)",
      "dusk": "oklch(0.62 0.07 235)",
      "role": "Field wash, cloud tiles, birds."
    },
    "lagoon": {
      "dawn": "oklch(0.82 0.085 200)",
      "dusk": "oklch(0.64 0.08 200)",
      "role": "Tide caustics, fish tiles, the lens caustic."
    },
    "moss": {
      "dawn": "oklch(0.7 0.08 140)",
      "dusk": "oklch(0.6 0.07 140)",
      "role": "Breeze glyphs, island tiles. Also the positive semantic."
    },
    "sand": {
      "dawn": "oklch(0.85 0.07 85)",
      "dusk": "oklch(0.7 0.07 82)",
      "role": "Island tiles, the warm fringe, warnings."
    },
    "stone": {
      "dawn": "oklch(0.64 0.018 240)",
      "dusk": "oklch(0.5 0.018 235)",
      "role": "Neutral tiles and pebbles."
    },
    "coral": {
      "dawn": "oklch(0.64 0.15 28)",
      "dusk": "oklch(0.7 0.14 30)",
      "role": "Rare: one creature per scene, or the loss semantic. Never decoration in bulk."
    }
  },
  "metal": {
    "steel": {
      "dawn": "oklch(0.8 0.012 240)",
      "dusk": "oklch(0.6 0.02 230)",
      "role": "Pearl body between highlights."
    },
    "shine": {
      "dawn": "oklch(1 0 0)",
      "dusk": "oklch(0.985 0.01 210)",
      "role": "Travelling specular."
    },
    "glint": {
      "dawn": "oklch(0.42 0.02 240)",
      "dusk": "oklch(0.3 0.02 230)",
      "role": "The dark counter-glint that makes a pearl rim read on paper."
    },
    "fringe-a": {
      "dawn": "oklch(0.8 0.1 205)",
      "dusk": "oklch(0.82 0.1 205)",
      "role": "Spectral fringe: lagoon."
    },
    "fringe-b": {
      "dawn": "oklch(0.86 0.09 85)",
      "dusk": "oklch(0.86 0.09 85)",
      "role": "Spectral fringe: sand. Pearl has no magenta."
    },
    "fringe-c": {
      "dawn": "oklch(0.78 0.08 245)",
      "dusk": "oklch(0.78 0.08 245)",
      "role": "Spectral fringe: sky."
    }
  },
  "radius": {
    "chip": 14,
    "card": 26,
    "lens": 32,
    "capsule": 999
  },
  "motion": {
    "ua": {
      "degPerSecond": 24
    },
    "fieldSpeedMax": 0.2,
    "breath": [
      7.2,
      11.6,
      18.8
    ]
  },
  "typeDefault": "manrope",
  "typeThemes": {
    "manrope": {
      "display": "Manrope, \"SF Pro Display\", ui-sans-serif, system-ui, sans-serif",
      "text": "Inter, \"SF Pro Text\", ui-sans-serif, system-ui, sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, Menlo, monospace",
      "displayWeight": 300,
      "displayTracking": "-0.045em",
      "em": {
        "font": "var(--ld-font-display)",
        "weight": 400,
        "style": "normal",
        "scale": 1
      },
      "role": "The first voice: geometric, light, airy."
    },
    "inter-tight": {
      "display": "\"Inter Tight\", \"SF Pro Display\", ui-sans-serif, system-ui, sans-serif",
      "text": "Inter, \"SF Pro Text\", ui-sans-serif, system-ui, sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, Menlo, monospace",
      "displayWeight": 300,
      "displayTracking": "-0.04em",
      "em": {
        "font": "var(--ld-font-display)",
        "weight": 500,
        "style": "normal",
        "scale": 1
      },
      "role": "Closest to SF Pro: neutral, Apple-premium. The payoff steps up to 500."
    },
    "geist": {
      "display": "Geist, ui-sans-serif, system-ui, sans-serif",
      "text": "Geist, ui-sans-serif, system-ui, sans-serif",
      "mono": "\"Geist Mono\", ui-monospace, Menlo, monospace",
      "displayWeight": 300,
      "displayTracking": "-0.045em",
      "em": {
        "font": "var(--ld-font-display)",
        "weight": 400,
        "style": "normal",
        "scale": 1
      },
      "role": "Precise, technical calm; its mono pairs with the ASCII fields."
    },
    "instrument": {
      "display": "\"Instrument Sans\", ui-sans-serif, system-ui, sans-serif",
      "text": "\"Instrument Sans\", ui-sans-serif, system-ui, sans-serif",
      "mono": "\"Geist Mono\", ui-monospace, Menlo, monospace",
      "displayWeight": 400,
      "displayTracking": "-0.035em",
      "em": {
        "font": "\"Instrument Serif\", ui-serif, Georgia, serif",
        "weight": 400,
        "style": "italic",
        "scale": 1.08
      },
      "role": "Soft and warm: one Instrument Serif italic word carries the payoff. The only theme with italic emphasis."
    }
  }
}
