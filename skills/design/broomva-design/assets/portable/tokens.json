{
  "format": "broomva-semantic-tokens/1",
  "name": "Broomva blue-axis foundation",
  "version": "1.0.0",
  "color": {
    "brand": {
      "ink": { "$type": "color", "$value": "oklch(0.175 0.022 265)" },
      "blue": { "$type": "color", "$value": "oklch(0.60 0.12 260)" },
      "blueSecondary": { "$type": "color", "$value": "oklch(0.65 0.14 235)" }
    },
    "light": {
      "background": { "$type": "color", "$value": "oklch(1 0 0)" },
      "foreground": { "$type": "color", "$value": "oklch(0.175 0.022 265)" },
      "card": { "$type": "color", "$value": "oklch(1 0 0)" },
      "secondary": { "$type": "color", "$value": "oklch(0.966 0.003 265)" },
      "mutedForeground": { "$type": "color", "$value": "oklch(0.50 0.015 265)" },
      "border": { "$type": "color", "$value": "oklch(0.25 0.04 265 / 0.07)" },
      "input": { "$type": "color", "$value": "oklch(0.915 0.005 265)" },
      "selection": { "$type": "color", "$value": "oklch(0.60 0.12 260 / 0.09)" },
      "focus": { "$type": "color", "$value": "oklch(0.60 0.12 260)" }
    },
    "dark": {
      "background": { "$type": "color", "$value": "oklch(0.135 0.020 272)" },
      "foreground": { "$type": "color", "$value": "oklch(0.965 0.004 265)" },
      "card": { "$type": "color", "$value": "oklch(0.175 0.025 272)" },
      "secondary": { "$type": "color", "$value": "oklch(0.165 0.022 272)" },
      "mutedForeground": { "$type": "color", "$value": "oklch(0.62 0.020 270)" },
      "border": { "$type": "color", "$value": "oklch(0.62 0.05 268 / 0.11)" },
      "input": { "$type": "color", "$value": "oklch(0.26 0.028 272)" },
      "selection": { "$type": "color", "$value": "oklch(0.60 0.12 260 / 0.13)" },
      "focus": { "$type": "color", "$value": "oklch(0.60 0.12 260)" }
    },
    "functional": {
      "success": { "$type": "color", "$value": "oklch(0.62 0.17 152)" },
      "information": { "$type": "color", "$value": "oklch(0.60 0.12 260)" },
      "warning": { "$type": "color", "$value": "oklch(0.76 0.15 85)" },
      "danger": { "$type": "color", "$value": "oklch(0.56 0.21 27)" }
    }
  },
  "typography": {
    "family": {
      "interface": { "$type": "fontFamily", "$value": ["ui-sans-serif", "system-ui", "sans-serif"] },
      "display": { "$type": "fontFamily", "$value": ["CalSans", "ui-sans-serif", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "monospace"] }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "sm": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
      "base": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "lg": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
      "xl": { "$type": "dimension", "$value": { "value": 22, "unit": "px" } },
      "2xl": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
      "screenTitle": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.25 },
      "normal": { "$type": "number", "$value": 1.5 },
      "relaxed": { "$type": "number", "$value": 1.6 }
    }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "5": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "8": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "10": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
    "12": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } }
  },
  "radius": {
    "compact": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
    "control": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "card": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "dialog": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "feature": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
    "pill": { "$type": "dimension", "$value": { "value": 9999, "unit": "px" } }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": { "value": 150, "unit": "ms" } },
      "common": { "$type": "duration", "$value": { "value": 200, "unit": "ms" } },
      "slow": { "$type": "duration", "$value": { "value": 350, "unit": "ms" } },
      "morph": { "$type": "duration", "$value": { "value": 500, "unit": "ms" } }
    },
    "standardEasing": { "$type": "cubicBezier", "$value": [0.25, 0.1, 0.25, 1] }
  },
  "$extensions": {
    "broomva": {
      "canonicalColorSpace": "oklch",
      "adapterRule": "Translate semantic roles through platform theme APIs. Keep these values as the canonical source and document tested fallbacks when OKLCH is unavailable."
    }
  }
}
