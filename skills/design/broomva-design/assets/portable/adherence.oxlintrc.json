{
  "plugins": ["react", "import"],
  "rules": {
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlays/**"
            ],
            "message": "Import Broomva web components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color: use a Broomva semantic token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw pixel value: use a Broomva spacing or type token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|soft|ghost)$/]",
        "message": "<Button> variant must be primary, secondary, soft, or ghost."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:success|info|warning|danger|neutral)$/]",
        "message": "<StatusBadge> status must be success, info, warning, danger, or neutral."
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/index.js"],
      "rules": { "no-restricted-imports": "off" }
    }
  ]
}
