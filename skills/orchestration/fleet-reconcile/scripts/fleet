#!/bin/sh
# fleet-reconcile is now the fleet skill (BRO-3122). Deprecated alias for one
# release: forwards every argument to ../../fleet/scripts/fleet. The notice
# goes to stderr, so stdout and the exit code are fleet's own. As in fleet,
# `send-gate pre` (a PreToolUse hook) fails with 2, the code that blocks.
fail=70
[ "${1:-}" = send-gate ] && [ "${2:-}" = pre ] && fail=2
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self") || exit $fail
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
dir=$(CDPATH='' cd -P -- "$(dirname -- "$self")/../../fleet/scripts" && pwd) || exit $fail
echo "fleet-reconcile: deprecated, renamed to fleet; use $dir/fleet" >&2
exec "$dir/fleet" "$@"
