<?xml version="1.0" encoding="UTF-8"?>
<!--
  fleet-reconcile: the hourly tick for one scope (spec §5.3, §5.7).
  Rendered and loaded by scripts/install.sh, which the owner runs; nothing
  else loads it. StartInterval 3600 is the owner's cadence. There is no
  ProcessType key on purpose: under the Background QoS a Python process took
  about three times as long (build-readiness evidence §2).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{LABEL}}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{SKILL_DIR}}/scripts/tick.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>FLEET_SCOPE</key>
        <string>{{SCOPE}}</string>
        <key>FLEET_CONFIG</key>
        <string>{{CONFIG}}</string>
        <key>HOME</key>
        <string>{{HOME}}</string>
        <key>PATH</key>
        <string>{{PATH}}</string>
    </dict>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/{{LABEL}}.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/{{LABEL}}.log</string>
</dict>
</plist>
